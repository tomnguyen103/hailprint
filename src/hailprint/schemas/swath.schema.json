{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hailprint.invalid/schemas/swath.schema.json",
  "title": "Swath",
  "description": "One MultiPolygon feature per hail size class, with a receipt as a foreign member.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "receipt", "features"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "receipt": { "$ref": "receipt.schema.json" },
    "features": {
      "type": "array",
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "properties", "geometry"],
        "properties": {
          "type": { "const": "Feature" },
          "properties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["threshold_mm", "threshold_in", "label", "area_km2"],
            "properties": {
              "threshold_mm": { "type": "number", "exclusiveMinimum": 0 },
              "threshold_in": { "type": "number", "exclusiveMinimum": 0 },
              "label": { "type": "string", "minLength": 1 },
              "area_km2": { "type": "number", "minimum": 0 }
            }
          },
          "geometry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "coordinates"],
            "properties": {
              "type": { "const": "MultiPolygon" },
              "coordinates": {
                "type": "array",
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "array",
                    "minItems": 4,
                    "items": { "$ref": "#/$defs/position" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number" }
    }
  }
}
