{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hailprint.invalid/schemas/power.schema.json",
  "title": "Power",
  "description": "Customers without power per metro county at 192 steps of 15 minutes in the impact window, with a receipt. A null step is a gap in the source, never zero.",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt", "window", "source", "utilities", "counties"],
  "properties": {
    "receipt": { "$ref": "receipt.schema.json" },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "step_minutes", "steps"],
      "properties": {
        "start": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T12:00:00Z$" },
        "step_minutes": { "const": 15 },
        "steps": { "const": 192 }
      }
    },
    "source": { "enum": ["eaglei", "odin"] },
    "utilities": {
      "oneOf": [
        { "type": "null" },
        { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      ]
    },
    "counties": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        { "$ref": "#/$defs/county", "properties": { "fips": { "const": "48201" } } },
        { "$ref": "#/$defs/county", "properties": { "fips": { "const": "48157" } } },
        { "$ref": "#/$defs/county", "properties": { "fips": { "const": "48339" } } },
        { "$ref": "#/$defs/county", "properties": { "fips": { "const": "48039" } } },
        { "$ref": "#/$defs/county", "properties": { "fips": { "const": "48167" } } },
        { "$ref": "#/$defs/county", "properties": { "fips": { "const": "48473" } } },
        { "$ref": "#/$defs/county", "properties": { "fips": { "const": "48291" } } },
        { "$ref": "#/$defs/county", "properties": { "fips": { "const": "48071" } } }
      ]
    }
  },
  "allOf": [
    {
      "if": { "required": ["source"], "properties": { "source": { "const": "odin" } } },
      "then": { "properties": { "utilities": { "type": "array" } } },
      "else": { "properties": { "utilities": { "type": "null" } } }
    }
  ],
  "$defs": {
    "county": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fips", "name", "customers", "out"],
      "properties": {
        "fips": { "type": "string", "pattern": "^48\\d{3}$" },
        "name": { "type": "string", "minLength": 1 },
        "customers": { "type": "integer", "minimum": 1 },
        "out": {
          "type": "array",
          "minItems": 192,
          "maxItems": 192,
          "items": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    }
  }
}
